# Production environment template.
#
# Do not commit a filled-in copy. Inject these from your secret manager
# (Kubernetes Secret, AWS Secrets Manager, Doppler, etc.), not from a file in
# the image.
#
# Required values have no default in src/config.rs; the app fails fast if one
# is missing. Optional values show the default in a comment.

# --- Runtime -----------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# Keep logs free of tokens, signed URLs and PII. Never use `debug` in prod.
RUST_LOG=info,tower_http=warn
# Recommended 0 in production: run `sqlx migrate run` as a separate one-shot
# job under an advisory lock, not on every replica's boot.
RUN_MIGRATIONS=0

# --- Database ----------------------------------------------------------------
# Dedicated, least-privilege role (not the superuser). TLS is mandatory.
# sslmode=require; add sslrootcert=... if the CA is not in the system store.
DATABASE_URL=postgres://erp_app:CHANGE_ME@db.internal:5432/erp_commerce?sslmode=require
# Leave headroom below PostgreSQL's max_connections for admin and workers.
DATABASE_MAX_CONNECTIONS=20

# --- Redis -------------------------------------------------------------------
# Required by config today; used by the worker queues from P4 onwards.
# rediss:// enables TLS.
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0

# --- Auth --------------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
# Rotate on a schedule; rotating invalidates every issued token.
JWT_SECRET=CHANGE_ME_48_BYTES_BASE64
JWT_TTL_SECONDS=3600

# --- Object storage: Cloudflare R2 -------------------------------------------
# Endpoint is the account endpoint, WITHOUT the bucket name:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# The app forces path-style addressing, which R2 supports.
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
# R2 has no regions; the AWS SDK still requires one.
S3_REGION=auto
S3_BUCKET=erp-commerce-prod
# R2 API token -> Access Key ID / Secret Access Key.
# Scope it to this bucket with Object Read & Write only.
S3_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY_ID
S3_SECRET_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
# Downloads are always short lived; the code clamps this to 900 s.
SIGNED_URL_TTL_SECONDS=900
SIGNED_UPLOAD_TTL_SECONDS=300

# --- Payments ----------------------------------------------------------------
# Required if POST /webhooks/payment/* is exposed; empty disables verification
# and every webhook is rejected. Generate with: openssl rand -hex 32
# Stripe uses this as the HMAC secret; bKash/SSLCommerz use it as the shared
# X-Webhook-Secret header until the real gateway integration lands.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_32_BYTES_HEX
# Base URL the client is sent to after POST /finance/topup. Unset = no redirect.
PAYMENT_REDIRECT_BASE=https://pay.example.com

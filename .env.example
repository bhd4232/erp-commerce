# --- Runtime -----------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info,tower_http=debug

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/erp_commerce
DATABASE_MAX_CONNECTIONS=10

# --- Cache / queue -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------------
# Must be at least 32 characters. Rotate every 90 days.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL_SECONDS=3600

# --- Object storage (S3 / Cloudflare R2) -------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=erp-commerce-dev
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Signed download URLs are always short lived (900 s = 15 min).
SIGNED_URL_TTL_SECONDS=900
SIGNED_UPLOAD_TTL_SECONDS=300
